# Local Docker FalkorDB defaults. For FalkorDB Cloud, paste host/port/user/password from the cloud console.
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
FALKORDB_GRAPH=rootcause

# Optional. Without it the app uses friendly template text and a built-in question bank.
ANTHROPIC_API_KEY=
