# Local Docker FalkorDB defaults. For FalkorDB Cloud, paste host/port/user/password from the cloud console.
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
FALKORDB_GRAPH=rootcause

# Optional. Without it the app uses friendly template text, a built-in question bank and graph-built notes.
OPENROUTER_API_KEY=
# Any OpenRouter model id; this default is fast and cheap.
OPENROUTER_MODEL=anthropic/claude-haiku-5.5
